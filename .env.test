# Throwaway credentials for the Phase 0 test harness (backend/tests/).
# Loaded BEFORE backend.utils.env's real .env/.env.local load, with override=True,
# so the test process never touches real Supabase/Anthropic/connector data.
#
# ANTHROPIC_API_KEY must be a non-empty placeholder — backend/main.py raises
# RuntimeError at import time if it's falsy. It is never sent to a real Anthropic
# call by the smoke suite (no chat/streaming endpoints are exercised there).
ANTHROPIC_API_KEY=test-placeholder-key

# Left empty on purpose: every route audited in STABILITY-AUDIT.md degrades to a
# documented "not configured" fallback (empty list/dict, {"connected": false}, etc.)
# when these are unset.
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
Mem0_API_KEY=
OPENAI_API_KEY=
GOOGLE_AUTH_ID=
GOOGLE_AUTH_SECRET=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
BRAVE_SEARCH_API_KEY=
FAL_API_KEY=
CARTESIA_API_KEY=
JARVIS_VOICE_ID=
DEEPGRAM_API_KEY=
ADMIN_USER_IDS=
ADMIN_EMAILS=
