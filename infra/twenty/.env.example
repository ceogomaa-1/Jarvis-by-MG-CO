# ── Twenty self-host config ──────────────────────────────────────────────
# Copy to `.env` (same folder) and fill in. Never commit the real .env.

# Public URL the browser + Jarvis backend reach Twenty at.
# Local test:  http://localhost:3000
# Production:  https://crm.yourdomain.com   (put a TLS reverse proxy in front)
SERVER_URL=http://localhost:3000

# 32+ char random secret. Generate:  openssl rand -base64 32
APP_SECRET=replace-me-with-a-long-random-string

# Postgres credentials (used by server, worker, and the db container).
PG_DATABASE_USER=twenty
PG_DATABASE_PASSWORD=replace-me-with-a-strong-password

# Leave true to create the first workspace, then set to "false" and
# `docker compose up -d` again to lock down public signups.
IS_SIGN_UP_ENABLED=true

# ── What Jarvis backend needs (set these in the JARVIS env, not here) ─────
# After you create the workspace + API key (Settings → API & Webhooks):
#   TWENTY_API_URL=https://crm.yourdomain.com   # same as SERVER_URL, no trailing /graphql
#   TWENTY_API_KEY=<the key shown once>
