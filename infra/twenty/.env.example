# ── Twenty self-host config ──────────────────────────────────────────────
# Copy to `.env` (same folder) and fill in. Never commit the real .env.

# Public URL the browser + Jarvis backend reach Twenty at.
# Local test:  http://localhost:3000
# Production:  https://crm.yourdomain.com   (put a TLS reverse proxy in front)
SERVER_URL=http://localhost:3000

# 32+ char random secret. Generate:  openssl rand -base64 32
APP_SECRET=replace-me-with-a-long-random-string

# Postgres credentials (used by server, worker, and the db container).
PG_DATABASE_USER=twenty
PG_DATABASE_PASSWORD=replace-me-with-a-strong-password

# Leave true to create the first workspace, then set to "false" and
# `docker compose up -d` again to lock down public signups.
IS_SIGN_UP_ENABLED=true

# ── Phase 2: branded image + per-client workspaces ───────────────────────────
# Our white-labeled fork image (see FORK.md / branding/). For a plain upstream
# deploy, set: JARVIS_CRM_IMAGE=twentycrm/twenty:v0.42.0
JARVIS_CRM_IMAGE=ghcr.io/MG-CO/jarvis-crm:v0.42.0
# Native multi-workspace: one data-isolated workspace per client, subdomain-routed.
# Requires wildcard DNS + TLS for *.crm.jarvismgco.com.
IS_MULTIWORKSPACE_ENABLED=true
FRONTEND_BASE_URL=https://crm.jarvismgco.com
DEFAULT_SUBDOMAIN=app
# Rebranded transactional email on our domain (set real SMTP creds here).
EMAIL_FROM_ADDRESS=crm@jarvismgco.com
EMAIL_FROM_NAME=Jarvis CRM
EMAIL_SYSTEM_ADDRESS=crm@jarvismgco.com
EMAIL_DRIVER=smtp
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=

# ── What Jarvis backend needs (set these in the JARVIS env, not here) ─────
# Phase 1 single shared instance (still a valid fallback):
#   TWENTY_API_URL=https://crm.jarvismgco.com   # same as SERVER_URL, no trailing /graphql
#   TWENTY_API_KEY=<the key shown once>
# Phase 2 per-client workspaces are registered with the provisioning script instead:
#   python -m backend.scripts.provision_twenty_workspace --user-id <uuid> \
#       --base-url https://<client>.crm.jarvismgco.com --api-key <workspace key>
# (Backend needs SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY for the workspace registry.)
