# Jarvis CRM — Caddy edge config (Hostinger DNS, on-demand TLS, no DNS plugin).
#
# Per-subdomain HTTPS is issued on first request (HTTP-01/TLS-ALPN), gated by an "ask"
# to the Jarvis backend so certs are only minted for real provisioned workspaces.
#
# The apex (crm.jarvismgco.com) is the SHARED backend API: in multi-workspace, EVERY
# workspace frontend at <sub>.crm.jarvismgco.com calls the one SERVER_URL = the apex
# (Twenty uses a single REACT_APP_SERVER_BASE_URL, like Cloud's api.twenty.com). So the
# apex CANNOT be IP-locked — that blocked every user's API calls ("Unable to Reach
# Back-end"). Public *workspace creation* is instead blocked at the app layer:
# IS_WORKSPACE_CREATION_LIMITED_TO_SERVER_ADMINS=true, with a privileged provisioner
# account doing the creation (see AUTO-PROVISION.md). signUp can't be isolated by host or
# path — it rides the shared GraphQL API — so an edge IP-lock is the wrong layer for it.
#
# Paste to /etc/caddy/Caddyfile on the VPS, then: sudo systemctl reload caddy

{
    # Caddy asks Jarvis before issuing any on-demand cert (anti-abuse).
    on_demand_tls {
        ask https://jarvis-backend-4oz6.onrender.com/api/business/crm/tls-check
    }
}

crm.jarvismgco.com, *.crm.jarvismgco.com {
    # Per-hostname certs issued on demand — no wildcard, no DNS plugin needed.
    tls {
        on_demand
    }

    # Let the Jarvis app embed the cockpit (Phase 3).
    header -X-Frame-Options
    header Content-Security-Policy "frame-ancestors 'self' https://jarvismgco.com https://*.jarvismgco.com"

    # Apex + every subdomain proxy to the same Twenty server. The apex stays public
    # because it is the shared API; public workspace creation is blocked in-app
    # (IS_WORKSPACE_CREATION_LIMITED_TO_SERVER_ADMINS=true), not here.
    reverse_proxy localhost:3000
}
