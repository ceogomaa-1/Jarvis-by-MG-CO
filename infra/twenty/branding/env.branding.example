# ── Rue CRM branding / multi-tenant env ───────────────────────────────────
# These extend infra/twenty/.env. The visual white-label is baked into the image
# (see branding/README.md); these cover the env-driven bits: multi-workspace,
# transactional email sender, and the product name where Twenty reads it from env.

# Product name where env-configurable (emails, some headers).
SERVER_NAME=Rue CRM

# ── Multi-workspace (Phase 2: one workspace per client, subdomain-routed) ─────
# Each client workspace is reached at <subdomain>.crm.jarvismgco.com.
IS_MULTIWORKSPACE_ENABLED=true
# Base domain workspaces hang off of (no scheme). Wildcard DNS + TLS required:
#   *.crm.jarvismgco.com  →  this server
FRONTEND_BASE_URL=https://crm.jarvismgco.com
DEFAULT_SUBDOMAIN=app

# ── Transactional email (invites, password reset, notifications) ─────────────
# Rebranded sender on our domain. Provide real SMTP/Resend creds in .env (not here).
# SPF + DKIM for jarvismgco.com must be set in DNS or mail will land in spam.
EMAIL_FROM_ADDRESS=crm@jarvismgco.com
EMAIL_FROM_NAME=Rue CRM
EMAIL_SYSTEM_ADDRESS=crm@jarvismgco.com
EMAIL_DRIVER=smtp
EMAIL_SMTP_HOST=smtp.your-provider.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=replace-me
EMAIL_SMTP_PASSWORD=replace-me

# Support/docs link shown in-app (replaces Twenty's).
SUPPORT_URL=https://jarvismgco.com
